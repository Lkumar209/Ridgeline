# Copy to .env and fill in. Never commit .env.
# OpenEI Utility Rate Database key (optional; tariffs load from data/tariffs/ without it).
URDB_API_KEY=
# Anthropic API key, used by the agent layer (M6). Tests use a mock client and need no key.
ANTHROPIC_API_KEY=
# Model name for the agent layer (M6).
RIDGELINE_LLM_MODEL=
